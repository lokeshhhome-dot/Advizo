{% comment %}
  Consultly — Consultant Listing App Block.

  Intentionally thin: this shell only hands Shopify/merchant context to the
  storefront JS bundle (added in Step 4) via data attributes. No consultant
  data-fetching or card rendering happens here — that stays in JS, calling
  the App Proxy JSON endpoint added in Step 2 (/apps/advizo/consultants).
  This path is storefront-relative on purpose: the browser resolves it
  against whatever domain the merchant's store is on, so the same block
  works unmodified across every shop that installs the app — never hardcode
  a backend host here.
{% endcomment %}
<div
  class="advizo-consultant-card"
  id="advizo-consultant-card-{{ block.id }}"
  data-block-id="{{ block.id }}"
  data-shop="{{ shop.permanent_domain }}"
  data-api-url="/apps/advizo/consultants"
  data-limit="{{ block.settings.consultant_limit }}"
  {%- comment -%}
    TEMP (Theme Extension customer-ID debug test): `customer` is a standard
    Liquid global populated by Shopify itself from the shopper's storefront
    login session — the same session that App Proxy requests see as
    `logged_in_customer_id`. Server-rendered, so it can't be spoofed from the
    browser. Emits nothing (not even "null") when no customer is logged in.
    Numeric ID only — never customer.email/name/etc.
  {%- endcomment -%}
  data-shopify-customer-id="{% if customer %}{{ customer.id }}{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <h2 class="advizo-consultant-card__heading">{{ block.settings.heading }}</h2>
  {%- endif -%}

  {%- comment -%}
    Mount point for Step 4's JS. Until then this placeholder text is what a
    merchant sees when previewing the block in Theme Editor — enough to
    confirm placement without any real data-fetching yet.
  {%- endcomment -%}
  <div class="advizo-consultant-card__root" aria-live="polite">
    <p class="advizo-consultant-card__placeholder">{{ 'consultant_card.loading' | t }}</p>
  </div>
</div>

<link rel="stylesheet" href="{{ 'consultant-card.css' | asset_url }}">
<script src="{{ 'consultant-card.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Consultly Consultants",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet Our Consultants"
    },
    {
      "type": "range",
      "id": "consultant_limit",
      "label": "Number of consultants to show",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 12
    }
  ]
}
{% endschema %}
