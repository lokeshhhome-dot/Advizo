{% comment %}
  advizo — Astrology Tools (entry point) App Block.

  Deliberately the lightest block in this extension: static Liquid + one
  small stylesheet, NO JavaScript and no API calls. Each card is a plain
  link into the dedicated Astrology page (/pages/astrology?tool=...), where
  the Astrology Experience block (astrology.liquid) lazy-loads the actual
  tool. So placing this on the Home page (or any landing page) costs one
  ~5 KB CSS file — the astrology app itself is never loaded here.

  Unlike consultant-profile.liquid / my-profile.liquid there is NO page
  guard: this block is meant to be placed by the merchant wherever they
  want the entry cards (Home page, selected landing pages). Nothing is
  rendered globally unless the merchant adds it.
{% endcomment %}
{%- liquid
  # routes.root_url is "/" or a locale prefix ("/fr"), so this resolves to
  # /pages/astrology or /fr/pages/astrology: the page ensureAstrologyPage.js
  # creates on install, the only page the Astrology Experience block renders on.
  assign advizo_astro_root = routes.root_url | remove_last: '/'
  assign advizo_astro_dest = advizo_astro_root | append: '/pages/astrology'
  assign advizo_astro_sep = '?'
-%}

<section
  class="advizo-astro-tools advizo-astro-tools--{{ block.settings.background }}"
  id="advizo-astro-tools-{{ block.id }}"
  aria-labelledby="advizo-astro-tools-heading-{{ block.id }}"
  {{ block.shopify_attributes }}
>
  <div class="advizo-astro-tools__inner">
    <header class="advizo-astro-tools__header">
      <svg class="advizo-astro-tools__orbit" viewBox="0 0 120 24" aria-hidden="true" focusable="false">
        <path d="M2 20 C 30 2, 90 2, 118 20" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 4"/>
        <circle cx="60" cy="6.6" r="2.6" fill="currentColor"/>
      </svg>
      {%- if block.settings.eyebrow != blank -%}
        <p class="advizo-astro-tools__eyebrow">{{ block.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="advizo-astro-tools__heading" id="advizo-astro-tools-heading-{{ block.id }}">{{ block.settings.heading }}</h2>
      {%- if block.settings.subtitle != blank -%}
        <p class="advizo-astro-tools__subtitle">{{ block.settings.subtitle }}</p>
      {%- endif -%}
    </header>

    <ul class="advizo-astro-tools__grid" role="list">
      {%- if block.settings.show_kundli -%}
        <li class="advizo-astro-tools__item">
          <a class="advizo-astro-tools__card" href="{{ advizo_astro_dest }}{{ advizo_astro_sep }}tool=kundli">
            <span class="advizo-astro-tools__icon" aria-hidden="true">
              <svg viewBox="0 0 40 40" focusable="false"><rect x="5" y="5" width="30" height="30" rx="1.5"/><path d="M5 5l30 30M35 5L5 35M20 5l15 15-15 15L5 20z"/></svg>
            </span>
            <span class="advizo-astro-tools__kicker">{{ 'astrology.tools.kundli_kicker' | t }}</span>
            <span class="advizo-astro-tools__title">{{ 'astrology.tools.kundli_title' | t }}</span>
            <span class="advizo-astro-tools__desc">{{ 'astrology.tools.kundli_desc' | t }}</span>
            <span class="advizo-astro-tools__cta">{{ block.settings.kundli_cta }}<span class="advizo-astro-tools__arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
      {%- endif -%}
      {%- if block.settings.show_panchang -%}
        <li class="advizo-astro-tools__item">
          <a class="advizo-astro-tools__card" href="{{ advizo_astro_dest }}{{ advizo_astro_sep }}tool=panchang">
            <span class="advizo-astro-tools__icon" aria-hidden="true">
              <svg viewBox="0 0 40 40" focusable="false"><path d="M4 27h32"/><path d="M11 27a9 9 0 0 1 18 0"/><path d="M20 9v4M9.4 13.4l2.8 2.8M30.6 13.4l-2.8 2.8"/><path d="M7 33h4M18 33h4M29 33h4"/></svg>
            </span>
            <span class="advizo-astro-tools__kicker">{{ 'astrology.tools.panchang_kicker' | t }}</span>
            <span class="advizo-astro-tools__title">{{ 'astrology.tools.panchang_title' | t }}</span>
            <span class="advizo-astro-tools__desc">{{ 'astrology.tools.panchang_desc' | t }}</span>
            <span class="advizo-astro-tools__cta">{{ block.settings.panchang_cta }}<span class="advizo-astro-tools__arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
      {%- endif -%}
      {%- if block.settings.show_matchmaking -%}
        <li class="advizo-astro-tools__item">
          <a class="advizo-astro-tools__card" href="{{ advizo_astro_dest }}{{ advizo_astro_sep }}tool=matchmaking">
            <span class="advizo-astro-tools__icon" aria-hidden="true">
              <svg viewBox="0 0 40 40" focusable="false"><circle cx="15" cy="20" r="10"/><circle cx="25" cy="20" r="10"/><path d="M20 12.3v15.4" stroke-dasharray="1.5 2.5"/></svg>
            </span>
            <span class="advizo-astro-tools__kicker">{{ 'astrology.tools.matchmaking_kicker' | t }}</span>
            <span class="advizo-astro-tools__title">{{ 'astrology.tools.matchmaking_title' | t }}</span>
            <span class="advizo-astro-tools__desc">{{ 'astrology.tools.matchmaking_desc' | t }}</span>
            <span class="advizo-astro-tools__cta">{{ block.settings.matchmaking_cta }}<span class="advizo-astro-tools__arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
      {%- endif -%}
    </ul>
  </div>
</section>

<link rel="stylesheet" href="{{ 'astrology-tools.css' | asset_url }}" media="all">

{% schema %}
{
  "name": "Astrology Tools",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Vedic tools"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Understand your cosmic blueprint"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Personalised Vedic calculations from your birth details — explore them on your own, or talk them through with a consultant."
    },
    {
      "type": "header",
      "content": "Tools"
    },
    {
      "type": "checkbox",
      "id": "show_kundli",
      "label": "Show Kundli",
      "default": true
    },
    {
      "type": "text",
      "id": "kundli_cta",
      "label": "Kundli button label",
      "default": "View Kundli"
    },
    {
      "type": "checkbox",
      "id": "show_panchang",
      "label": "Show Panchang",
      "default": true
    },
    {
      "type": "text",
      "id": "panchang_cta",
      "label": "Panchang button label",
      "default": "View Panchang"
    },
    {
      "type": "checkbox",
      "id": "show_matchmaking",
      "label": "Show Match Making",
      "default": true
    },
    {
      "type": "text",
      "id": "matchmaking_cta",
      "label": "Match Making button label",
      "default": "Check match"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "warm", "label": "Warm neutral" },
        { "value": "plain", "label": "White" },
        { "value": "none", "label": "Transparent (use section colour)" }
      ],
      "default": "warm"
    }
  ]
}
{% endschema %}
