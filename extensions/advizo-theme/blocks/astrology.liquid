{% comment %}
  advizo — Astrology Experience App Block (Kundli · Panchang · Match Making).

  Same pattern as my-profile.liquid: a thin shell handing context to the JS
  bundle via data attributes. All data comes from App Proxy JSON endpoints
  under /apps/advizo/astrology/* — the backend calls the astrology provider
  with credentials that exist only in its environment. Nothing secret, and
  nothing customer-identifying, is ever rendered here; identity is resolved
  server-side from Shopify's signed App Proxy request.

  The active tool lives in the URL (?tool=kundli|panchang|matchmaking, plus
  &reading=<id> for a signed-in customer's saved reading), so tabs deep-link,
  survive refresh and work with Back. Birth details never go in the URL.

  ONE-TIME MERCHANT SETUP: the "Astrology" page (handle "astrology") is
  created on install by ensureAstrologyPage.js (create it manually for shops
  installed before this feature). In Theme Editor open that page → Add block
  → Apps → "Astrology Experience".

  PAGE GUARD: same convention as my-profile.liquid — renders only on the
  page with handle "astrology", so astrology.js/.css never load elsewhere.
{% endcomment %}
{%- assign advizo_is_astrology_page = false -%}
{%- if request.page_type == 'page' and page.handle == 'astrology' -%}
  {%- assign advizo_is_astrology_page = true -%}
{%- endif -%}

{%- if advizo_is_astrology_page -%}
  <div
    class="advizo-astro"
    id="advizo-astro-{{ block.id }}"
    data-block-id="{{ block.id }}"
    data-shop="{{ shop.permanent_domain }}"
    data-api-base="/apps/advizo/astrology"
    data-login-url="{{ routes.account_login_url }}"
    data-chart-style="{{ block.settings.chart_style }}"
    data-show-kundli="{{ block.settings.show_kundli }}"
    data-show-panchang="{{ block.settings.show_panchang }}"
    data-show-matchmaking="{{ block.settings.show_matchmaking }}"
    data-consult-url="{{ block.settings.consult_url }}"
    data-heading="{{ block.settings.heading | escape }}"
    {{ block.shopify_attributes }}
  >
    <div class="advizo-astro__root" aria-live="polite">
      <div class="advizo-astro__boot" role="status">
        <span class="advizo-astro__orbit" aria-hidden="true"><span></span></span>
        <span class="advizo-astro__boot-text">{{ 'astrology.experience.loading' | t }}</span>
      </div>
    </div>
    <noscript>
      <p class="advizo-astro__noscript">{{ 'astrology.experience.noscript' | t }}</p>
    </noscript>
  </div>

  <link rel="stylesheet" href="{{ 'astrology.css' | asset_url }}">
  <script src="{{ 'astrology.js' | asset_url }}" defer="defer"></script>
{%- elsif request.design_mode -%}
  {%- comment -%} Theme Editor only — never shown on the live storefront. {%- endcomment -%}
  <div {{ block.shopify_attributes }} style="padding:16px;border:1px dashed #c7cbd1;color:#6b7280;font:14px/1.4 -apple-system,sans-serif;">
    Astrology Experience block only renders on the "astrology" page — it will be hidden here on the live store. Use the "Astrology Tools" block for entry cards on other pages.
    <br>
    <code>page.handle = "{{ page.handle }}" | request.page_type = "{{ request.page_type }}" | template = "{{ template }}"</code>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Astrology Experience",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Astrology"
    },
    {
      "type": "checkbox",
      "id": "show_kundli",
      "label": "Show Kundli",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_panchang",
      "label": "Show Panchang",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_matchmaking",
      "label": "Show Match Making",
      "default": true
    },
    {
      "type": "select",
      "id": "chart_style",
      "label": "Chart style",
      "options": [
        { "value": "north", "label": "North Indian" },
        { "value": "south", "label": "South Indian" },
        { "value": "east", "label": "East Indian" }
      ],
      "default": "north"
    },
    {
      "type": "url",
      "id": "consult_url",
      "label": "Consultants page",
      "info": "Optional. Adds a \"Talk to a consultant\" link under each reading."
    }
  ]
}
{% endschema %}
